{
  "name": "adminbloc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Administrarea transparenta a unui bloc de locuinte",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "seed": "node scripts/seed-demo.mjs",
    "test": "vitest run --project unit",
    "test:integrare": "vitest run --project integrare",
    "test:acoperire": "vitest run --coverage",
    "test:functii": "deno test --allow-all --clean --coverage=coverage/deno supabase/functions/tests && deno coverage coverage/deno --exclude='tests/|motor\\.js' --lcov | node scripts/acoperire-deno.mjs",
    "test:db": "supabase test db",
    "acoperire:sql": "node scripts/acoperire-sql.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^30.1.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.1"
  }
}
