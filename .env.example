# Copiaza in .env.local. Fara aceste doua valori aplicatia ruleaza in modul
# demonstrativ, pe date in memorie.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<ANON_KEY din `supabase status`>

# Doar pentru dezvoltare. In productie, adresa aplicatiei si secretul
# procesatorului se pun ca secrete ale proiectului, nu in acest fisier:
#   supabase secrets set SITE_URL=https://adresa-aplicatiei
#   supabase secrets set PROCESATOR_SECRET=...
# Vezi sectiunea "Punerea in productie" din README.
